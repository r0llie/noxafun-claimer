RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# Never commit this. Use a wallet with only the ETH needed for gas.
PRIVATE_KEY=0xyour_private_key_here

# Noxa fee manager contract that exposes collect(address token).
FEE_MANAGER=0x9eFdC1A8e6E94f16A228e44f3025E1f346EE0417

# Option A: automatically fetch tokens created by this account from Noxa.
NOXA_ACCOUNT=0xYourCreatorWalletAddress

# Option B: or manually set comma/newline separated token addresses.
TOKEN_ADDRESSES=

# true = simulate only. false = send transactions.
DRY_RUN=true
